# /etc/moni/agent.env —— moni-agent 的 systemd EnvironmentFile
MONI_SERVER=wss://moni-rs.<subdomain>.workers.dev/ws/agent
MONI_TOKEN=mn_<server_id>_<secret>
# 首选间隔；实际以 Hub 动态下发的值为准（有人观看 2s，无人 30s）
MONI_INTERVAL=2
# 安装器固定仓库与内置或显式提供的可信公钥后写入；管理端只能指定版本，不能修改此源。
# MONI_UPDATE_REPO=owner/repo
# 自动更新通过 root systemd timer（--auto-update）启用，agent 本身保持 moni 用户权限。
# MONI_IFACES=eth0,ens3        # 网卡白名单，默认自动排除虚拟网卡
# MONI_DISKS=/,/data           # 挂载点白名单，默认统计所有 /dev/* 物理盘
# MONI_COUNTRY=auto            # 地区：auto 按本机网卡公网地址查询；off 交给 Cloudflare；或填 JP 等国家码
# MONI_QUEUE_CAPACITY=1440     # 内存中待确认分钟数，满后丢弃最旧的
# RUST_LOG=info
